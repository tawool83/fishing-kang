{
  "name": "fishing-kang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "강태공 — 지인 낚시 조과 실시간 랭킹 웹",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:og": "node scripts/build-og-image.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --project unit --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  }
}
